PORT=4000
NODE_ENV=development
MONGODB_URI=
REDIS_URL=
# Comma-separated. A `*` wildcard segment is supported for Vercel preview
# deployments, e.g. https://tech-cart-buyer-app-*.vercel.app
CORS_ORIGINS=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional — only used outside production (NODE_ENV !== "production").
# Resend needs a verified sending domain; Mailtrap's sandbox doesn't, so it's
# used for local dev/anything non-production instead. Unused in production.
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASS=
