PORT=4000
NODE_ENV=development
MONGODB_URI=
# Rate limiting on the auth surface (FR-AUTH-040–044). Default: true.
# Set to false for local / manual Postman testing so 429 RATE_LIMITED never
# fires — must stay true in a real deployment.
RATE_LIMITING_ENABLED=true
# Optional. Only used when RATE_LIMITING_ENABLED=true — makes the auth
# limiters Redis-backed (shared across instances). Without it they use
# per-instance in-memory counters. Upstash Redis-protocol string
# (rediss://...), not the REST API URL.
REDIS_URL=
# Comma-separated. A `*` wildcard segment is supported for Vercel preview
# deployments, e.g. https://tech-cart-buyer-app-*.vercel.app
CORS_ORIGINS=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=
# The backend's own public base URL — https:// here switches session/2FA
# cookies to SameSite=None; Secure for cross-site (Vercel <-> Render) delivery,
# and is the fallback origin for admin password-reset links.
APP_BASE_URL=http://localhost:4000
# Signs the session JWT (HS256). Minimum 32 characters.
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASS=
MAILTRAP_FROM_EMAIL=
# Consumed only by `npm run seed:super-admin` (not validated by env.ts) —
# all three are required, no hardcoded fallback.
SUPER_ADMIN_EMAIL=admin@techcart.com
SUPER_ADMIN_NAME=TechCart Super Admin
SUPER_ADMIN_PASSWORD=
