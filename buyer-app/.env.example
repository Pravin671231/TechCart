# Base URL of the backend API this app calls (buyer-app/src/store/api.ts).
# The app throws at startup if this is unset — see src/store/env.ts.
# Local dev default (matches backend's default PORT=4000): http://localhost:4000
NEXT_PUBLIC_API_URL=

# Google Identity Services client ID (One Tap + "Sign in with Google" button,
# src/features/auth/GoogleSignIn.tsx). Public, not a secret — same OAuth
# client backend's GOOGLE_CLIENT_ID refers to. The app throws at startup if
# this is unset — see src/store/env.ts.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
